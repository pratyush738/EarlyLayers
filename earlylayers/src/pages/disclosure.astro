---
import Base from '../layouts/Base.astro';
---
<Base title="Disclosure — EarlyLayers">
  <section class="article-head">
    <div class="wrap">
      <p class="mono">Disclosure</p>
      <h1>Independence, holdings, and corrections</h1>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="prose">
        <h2>Independence</h2>
        <p>EarlyLayers is independent. It takes no payment from the projects it covers, in any form, at any time — before, during, or after publication. No paid coverage, no sponsored research, no token compensation, no advisory arrangements with covered entities.</p>

        <h2>Holdings</h2>
        <p>Where the desk holds an asset it covers, the holding is disclosed here before the coverage publishes, and stays listed for as long as the position is held.</p>
        <table>
          <thead>
            <tr><th>Asset</th><th>Position</th><th>Disclosed since</th></tr>
          </thead>
          <tbody>
            <tr><td colspan="3">No positions currently disclosed.</td></tr>
          </tbody>
        </table>

        <h2>Corrections</h2>
        <p>Corrections are published in place, with the original text preserved, and logged here with the date and the record affected.</p>
        <p>No corrections issued.</p>
      </div>
    </div>
  </section>
</Base>
